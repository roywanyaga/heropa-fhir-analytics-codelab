#!/usr/bin/env bash
# Builds the dashboard into dashboard/dist, where nginx serves it.
# Called by the save watcher and by refresh. One build runs at a time.
set -uo pipefail
STATE="$HOME/.codelab"; mkdir -p "$STATE"
exec 9>"$STATE/build.lock"
flock 9

LOG="$HOME/build.log"
status() { # state
  printf '{"state":"%s","epoch":%s,"build":%s}\n' "$1" "$(date +%s)" "$(cat "$STATE/n" 2>/dev/null || echo 0)" > "$STATE/status.json.tmp"
  mv "$STATE/status.json.tmp" "$STATE/status.json"
}
n=$(( $(cat "$STATE/n" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$STATE/n"
status building

cd "$CODELAB_DIR/dashboard"
bash scripts/clear_data_cache.sh

# Use the database once the pipeline has made all six tables the dashboard
# reads and the patient table holds rows. The pipeline makes the tables one
# resource type after another, so a build in the middle of a run would fail on a
# table that is not there yet. Until then, build the empty state.
need="patient_flat group_flat encounter_flat condition_flat observation_flat immunization_flat"
have_tables="$(psql -X -q -w -t -A -c "SELECT count(*) FROM pg_tables WHERE schemaname='public' AND tablename IN ('patient_flat','group_flat','encounter_flat','condition_flat','observation_flat','immunization_flat')" 2>/dev/null || echo 0)"
patients="$(psql -X -q -w -t -A -c "SELECT count(*) FROM patient_flat" 2>/dev/null || echo 0)"
if [[ "${have_tables:-0}" -eq 6 && "${patients:-0}" -gt 0 ]]; then
  export LAB_SAMPLE=0
  echo "[$(date +%T)] Building the dashboard from the analytics database" >> "$LOG"
else
  export LAB_SAMPLE=empty
  echo "[$(date +%T)] The pipeline has not made all the tables yet ($have_tables of 6), so the dashboard shows an empty state" >> "$LOG"
fi

if npx observable build >> "$LOG" 2>&1; then
  echo "[$(date +%T)] BUILD OK" >> "$LOG"
  status ok
else
  echo "[$(date +%T)] BUILD FAILED. The Dashboard tab keeps the last good build. Read the lines above for the cause." >> "$LOG"
  status failed
  exit 1
fi
