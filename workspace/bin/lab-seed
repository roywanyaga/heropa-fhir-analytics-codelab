#!/usr/bin/env bash
# Runs once, in the background, when the lab first starts with an empty FHIR
# server. It loads the synthetic data and builds the empty dashboard. It does
# NOT run the pipeline: the learner does that, so they see the numbers appear.
# A lab started from the saved template finds the data already loaded.
set -uo pipefail
STATE="$HOME/.codelab"; mkdir -p "$STATE"
LOG="$HOME/build.log"
say() { echo "[$(date +%T)] $*" >> "$LOG"; }

until curl -fsS "$FHIR_URL/metadata" >/dev/null 2>&1; do sleep 5; done
total="$(curl -fsS "$FHIR_URL/Patient?_summary=count" | jq -r '.total // 0')"
if [[ "$total" -eq 0 ]]; then
  say "The FHIR server is empty. Loading the synthetic data"
  generate-data >> "$LOG" 2>&1 || { say "Loading the data failed"; exit 1; }
else
  say "The FHIR server already holds $total patients"
fi

build-dashboard || true
touch "$STATE/seeded"
say "The lab is ready. The FHIR server holds the data. Run the pipeline to fill the tables."
