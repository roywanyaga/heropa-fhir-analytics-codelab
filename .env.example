# Settings for one lab.
#
# lab-init.sh copies this file to .env on its first run. After that it reads
# .env, and it writes back the values it works out. To change a setting, edit
# .env and run ./lab-init.sh again. Every value goes inside double quotes.
#
# To change a default for every lab started from a template, edit this file
# before saving the template, because ./lab-init.sh --clean removes .env.
#
# A setting given on the command line wins over this file for that run, as in
#   LAB_CERT=none LAB_HOST=localhost ./lab-init.sh

# ---------------------------------------------------------------------------
# Settings you may change
# ---------------------------------------------------------------------------

# IDE_AUTH decides whether the editor asks for a password.
#
#   password   The editor asks for the code in IDE_PASSWORD. This is the
#              default and the right choice on Heropa.
#   none       The editor opens with no password. Anyone who reaches the lab
#              address gets the editor and the terminal inside it. Use this
#              only on your own machine, or where the Heropa inbound rules let
#              in one network you trust and nothing else.
IDE_AUTH="password"

# IDE_PASSWORD is the code the editor asks for when IDE_AUTH is password.
#
#   empty      lab-init.sh makes a code of four digits on its first run and
#              writes it here. This is the default.
#   a value    Your own password, of any length. Avoid quotes, dollar signs,
#              backticks and backslashes.
#
# The code is kept while IDE_AUTH is none, so switching back brings it back.
IDE_PASSWORD=""

# LAB_CERT decides how the lab gets the certificate for its HTTPS address.
#
#   letsencrypt   Asks Let's Encrypt for a certificate browsers trust. This is
#                 the default and the right choice on Heropa. It needs inbound
#                 TCP 80 and 443 open to everyone. When no certificate can be
#                 had, the lab still starts, in reduced mode with a
#                 self-signed one, and tries again on a later run.
#   self-signed   Makes its own certificate and goes straight to reduced
#                 mode. Browsers show a warning page, and the editor has no
#                 Guide, Build log or Output pane. Use it to see what a
#                 learner gets after a fallback.
#   none          No certificate. The lab serves plain HTTP. It is allowed
#                 only with LAB_HOST set to localhost, for a test on your own
#                 machine, where the editor works in full.
LAB_CERT="letsencrypt"

# LAB_HOST is the name the lab answers on.
#
#   empty       The name is made from the public IP of the VM, as in
#               203-0-113-10.sslip.io. This is the default and the right
#               choice on Heropa.
#   localhost   For a test on your own machine, together with LAB_CERT none.
#   a name      Any other name that already points at this machine.
LAB_HOST=""

# PUBLIC_IP is the public IPv4 address of the VM.
#
#   empty      Read from the cloud's metadata service on every run, so a
#              changed IP is noticed. This is the default.
#   an IP      Used as given, for a machine with no metadata service. It is
#              ignored when LAB_HOST is set.
PUBLIC_IP=""

# LAB_HTTP_PORT and LAB_HTTPS_PORT are the ports nginx publishes on the VM.
# Keep 80 and 443 on Heropa, because Let's Encrypt checks on port 80. Change
# them only for a local test where those ports are taken, for example to 8080
# and 8443.
LAB_HTTP_PORT="80"
LAB_HTTPS_PORT="443"

# LAB_QR decides whether lab-init.sh prints a QR code under the addresses.
#
#   on    Prints a code for the App, so a learner can open it on a phone or
#         tablet. This is the default. It needs the qrencode package, which
#         provision-heropa.sh installs. Without it the addresses are printed
#         alone.
#   off   Prints the addresses alone. Use this when the terminal draws the
#         code as broken characters.
#
# The Editor gets no code. The start page of the lab shows the App code
# either way. A lab on localhost gets no code at all, because a phone cannot
# reach that address.
LAB_QR="on"

# CERTBOT_EMAIL is an address for the Let's Encrypt account, which receives
# notices about the certificates. It is optional, and empty means no address.
CERTBOT_EMAIL=""

# LAB_ACME_SERVER is the directory URL of the service asked for certificates.
#
#   empty      The real Let's Encrypt service. This is the default.
#   a URL      Another ACME service. The Let's Encrypt staging one is
#              https://acme-staging-v02.api.letsencrypt.org/directory and
#              tests the requests without using up the real limits. Browsers
#              do not trust its certificates.
LAB_ACME_SERVER=""

# ---------------------------------------------------------------------------
# Values lab-init.sh writes. Do not edit them, because the next run replaces
# them.
# ---------------------------------------------------------------------------

# LAB_URL is the address of the lab, which the Editor and App addresses are
# built on. It changes when the public IP changes.
LAB_URL=""

# LAB_MODE is full when browsers trust the certificate, and reduced when the
# lab fell back to a self-signed one.
LAB_MODE=""

# LAB_NGINX_CONF names the nginx front in use, which is lab-https, or
# lab-http when LAB_CERT is none.
LAB_NGINX_CONF=""
LAB_PIPES_URL=""
