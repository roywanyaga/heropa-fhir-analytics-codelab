# The front of a analytics lab VM. The nginx image fills in LAB_URL when the
# container starts.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Plain HTTP only sends the browser to HTTPS. The editor needs a secure page
# for the clipboard and for its web views.
server {
    listen 80;
    server_name _;
    return 301 ${LAB_URL}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/lab.crt;
    ssl_certificate_key /etc/nginx/certs/lab.key;

    include /etc/nginx/lab-routes.conf;
}

# The FHIR Data Pipes controller has no sign-in of its own and its pages use
# links from the root, so it gets a port of its own on the same name.
# Its UI starts pipeline runs, so only a lab VM behind the inbound rules should
# publish it.
server {
    listen 8443 ssl;
    ssl_certificate     /etc/nginx/certs/lab.crt;
    ssl_certificate_key /etc/nginx/certs/lab.key;
    server_name _;

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $pipes http://pipeline-controller:8080;
        proxy_pass $pipes;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
